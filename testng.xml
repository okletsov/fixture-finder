<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Main Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="genericHelpers.TestFailureListener"/>
        <listener class-name="genericHelpers.RetryFilterListener"/>
    </listeners>

    <test name="ProcessToday">
        <parameter name="day" value="today"/>
        <classes>
            <class name="tests.Test_ProcessDay"/>
        </classes>
    </test>

    <test name="ProcessTomorrow">
        <parameter name="day" value="tomorrow"/>
        <classes>
            <class name="tests.Test_ProcessDay"/>
        </classes>
    </test>

    <test name="UpdateResult">
        <classes>
            <class name="tests.Test_UpdateResults"/>
        </classes>
    </test>
</suite>
